{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限：允许前端调用核心命令（笔记 CRUD / 搜索）",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "allow-list-nodes",
    "allow-get-node",
    "allow-save-node",
    "allow-delete-node",
    "allow-move-node",
    "allow-clear-all",
    "allow-put-many",
    "allow-next-order",
    "allow-search-nodes",
    "allow-get-data-dir",
    "allow-set-data-dir",
    "allow-save-file",
    "allow-list-foreshadowings",
    "allow-add-foreshadow",
    "allow-set-foreshadow-done",
    "allow-delete-foreshadow",
    "allow-list-assets",
    "allow-get-asset",
    "allow-save-asset",
    "allow-delete-asset",
    "allow-list-asset-categories",
    "allow-save-asset-category",
    "allow-delete-asset-category",
    "allow-put-many-assets",
    "allow-put-many-asset-categories",
    "allow-clear-all-assets",
    "allow-list-shortcuts",
    "allow-get-shortcut",
    "allow-save-shortcut",
    "allow-delete-shortcut",
    "allow-list-shortcut-categories",
    "allow-save-shortcut-category",
    "allow-delete-shortcut-category",
    "allow-put-many-shortcuts",
    "allow-put-many-shortcut-categories",
    "allow-clear-all-shortcuts",
    "allow-get-meta",
    "allow-set-meta",
    "allow-scan-folder",
    "allow-read-file-bytes",
    "allow-list-mounted-folders",
    "allow-add-mounted-folder",
    "allow-remove-mounted-folder",
    "allow-reorder-mounted-folders",
    "allow-get-book-progress",
    "allow-set-book-progress",
    "allow-list-book-notes",
    "allow-add-book-note",
    "allow-delete-book-note",
    "allow-list-all-book-notes",
    "allow-get-media-progress",
    "allow-set-media-progress",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "opener:allow-reveal-item-in-dir",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-is-minimized",
    "core:window:allow-destroy",
    "core:window:allow-set-closable",
    "core:window:allow-set-minimizable",
    "core:window:allow-set-maximizable"
  ]
}
